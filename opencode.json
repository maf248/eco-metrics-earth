{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode-go/glm-5.2",
  "provider": {
    "copilot": {},
    "openrouter": {}
  },
  "agent": {
    "orchestrator": {
      "model": "opencode-go/glm-5.2"
    },
    "coder": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "reviewer": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "tester": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "spec-writer": {
      "model": "opencode-go/glm-5.2"
    },
    "explore": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "general": {
      "model": "opencode-go/glm-5.2"
    }
  },
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["npx", "nx", "mcp"],
      "enabled": true
    }
  }
