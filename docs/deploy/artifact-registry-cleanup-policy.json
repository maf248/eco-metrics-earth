[
  {
    "name": "keep-recent-production-images",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "packageNamePrefixes": ["api-production"],
      "keepCount": 3
    }
  },
  {
    "name": "keep-recent-development-images",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "packageNamePrefixes": ["api-development"],
      "keepCount": 3
    }
  },
  {
    "name": "delete-older-environment-images",
    "action": { "type": "Delete" },
    "condition": {
      "tagState": "any",
      "packageNamePrefixes": ["api-production", "api-development"],
      "olderThan": "1d"
    }
  }
]
