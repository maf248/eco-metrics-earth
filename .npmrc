# legacy-peer-deps=true is required because eslint-plugin-jsx-a11y@6.10.2 (latest)
# declares peer eslint@"^3...^9" but has not yet updated its range to include ^10.
# The plugin is fully compatible with ESLint 10 at runtime.
# Remove this once eslint-plugin-jsx-a11y releases a version that supports ESLint 10.
legacy-peer-deps=true
