      >
        <h2
          class="text-2xl font-semibold text-fg"
          id="sources-heading"
        >
          Where the data comes from
        </h2>
        <p
          class="mt-4 text-fg-body"
        >
          Every figure on this site comes from an open, cited source, with its publisher, license and date. See the 
          <a
            class="rounded-sm text-accent underline hover:text-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus-ring focus-visible:ring-offset-2 ring-offset-focus-offset"
            href="/data-sources"
          >
            data sources
          </a>
           behind each topic.
        </p>
      </section>
    </div>
  </div>
</DocumentFragment>
`;
