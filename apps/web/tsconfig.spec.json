{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "types": ["jest", "node", "@testing-library/jest-dom"],
    "module": "commonjs",
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts",
    "__tests__/**/*.test.ts",
    "__tests__/**/*.test.tsx"
  ]
}
