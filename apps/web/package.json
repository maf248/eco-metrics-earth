{
  "name": "web",
  "version": "2.1.0",
  "private": true,
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.json --noEmit",
          "cwd": "apps/web"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/src/**/*.tsx"
        ]
      },
      "analyze": {
        "executor": "nx:run-commands",
        "options": {
          "command": "ANALYZE=true npx nx build web -- --webpack",
          "cwd": "."
        },
        "cache": false
      }
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
