{
  "name": "web",
  "version": "2.23.1",
  "private": true,
  "dependencies": {
    "@sentry/nextjs": "11.11.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.1",
    "echarts": "6.1.0",
    "flag-icons": "7.6.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "^typecheck"
        ],
        "inputs": [
          "{projectRoot}/tsconfig.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/src/**/*.tsx",
          "{projectRoot}/__tests__/**/*.ts",
          "{projectRoot}/__tests__/**/*.tsx",
          "{projectRoot}/e2e/**/*.ts",
          "^production"
        ],
        "options": {
          "command": "tsc -p tsconfig.json --noEmit",
          "cwd": "apps/web"
        }
      },
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "NEXT_PUBLIC_SENTRY_DSN"
          }
        ]
      },
      "analyze": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "ANALYZE=true npx nx build web -- --webpack",
          "cwd": "."
        }
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js",
          "{workspaceRoot}/scripts/**/*",
          "{workspaceRoot}/.github/workflows/**/*",
          "{workspaceRoot}/docs/**/*",
          "{workspaceRoot}/AGENTS.md",
          "{workspaceRoot}/ROADMAP.md",
          "{workspaceRoot}/README.md",
          "{workspaceRoot}/postman/**/*",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/apps/api/package.json"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
