# Canonical base URL used for SEO metadata (Open Graph, canonical links).
# Set this to the production domain (e.g. https://eco-metrics.earth).
# Falls back to http://localhost:3000 when not set.
NEXT_PUBLIC_SITE_URL=

# Base URL of the NestJS BFF (server-side only — not NEXT_PUBLIC_).
# Default for local development: http://localhost:3001/api/v1
# In production, point this at the deployed API URL (e.g. the Cloud Run service — see docs/deploy/cloud-run.md).
API_BASE_URL=

# Bundle analyzer — set to true to generate an HTML report after build.
# Run: npm run analyze
ANALYZE=false
