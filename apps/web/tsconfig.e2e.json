{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "e2e/**/*.js", "playwright.config.ts"],
  "exclude": ["out-tsc", "test-output"],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
