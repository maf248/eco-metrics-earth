# Application
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of exact allowed origins for cross-origin requests from the web frontend.
# A single origin is valid (e.g. https://your-app.vercel.app). Wildcards are not allowed here;
# use CORS_ORIGIN_PATTERN below for pattern-based origins such as Vercel preview deployments.
# Default when unset: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# CORS — optional anchored regex (^...$) for origin families that cannot be enumerated exactly,
# for example Vercel preview URLs. Leave empty or unset to allow only the exact origins above.
# Example:
# CORS_ORIGIN_PATTERN=^https://eco-metrics-earth-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_PATTERN=

# Swagger/OpenAPI — enable or disable the interactive API documentation UI.
# Set to "true" in development, "false" in production by default.
SWAGGER_ENABLED=false

# OWID data layer — all variables have defaults, so no deploy configuration is needed on Cloud Run.
# Base URLs must NOT end with a trailing slash (that would produce broken request URLs like https://.../grapher//slug.csv).
# OWID_GRAPHER_BASE_URL=https://ourworldindata.org/grapher
# OWID_API_BASE_URL=https://api.ourworldindata.org/v1
# OWID_HTTP_TIMEOUT_MS=10000
# OWID_CACHE_TTL_SECONDS=86400

# Provider snapshot fallback — optional. When the data provider (OWID) is down, the API serves the
# last good payload stored in a Google Cloud Storage bucket (`meta.stale: true`) instead of a 502.
# Leave SNAPSHOT_BUCKET unset or empty to disable persistence (the default; local development never
# needs it). SNAPSHOT_PREFIX is required whenever SNAPSHOT_BUCKET is set (kebab-case; one per
# environment, e.g. production or development). The deploy workflow sets both from the optional
# SNAPSHOT_BUCKET repository variable. The writes stay inside the GCS Always Free tier (see
# docs/deploy/cloud-run.md). Credentials: Application Default Credentials only, no key files.
# SNAPSHOT_BUCKET=
# SNAPSHOT_PREFIX=development

# Trusted reverse-proxy hops in front of the API (Express `trust proxy`), a non-negative integer.
# 0 = ignore X-Forwarded-For (local development). Cloud Run uses 1; the deploy workflow sets it.
TRUST_PROXY_HOPS=0

# Shared secret (min 32 characters) that every request must send in the X-Internal-Api-Key header
# (except GET /api/v1/health). Required when NODE_ENV=production; optional otherwise (unset or empty
# means the API accepts every request).
# Generate one with: openssl rand -hex 32
# INTERNAL_API_KEY=

# Production notes (Cloud Run):
# - PORT is injected by Cloud Run at runtime — never set it manually in the service env vars.
# - CORS_ORIGIN may contain multiple origins separated by commas.
# - CORS_ORIGIN_PATTERN is optional; set it to an anchored regex to allow Vercel preview origins.
# - SWAGGER_ENABLED should be "false" in production.
# - TRUST_PROXY_HOPS=1 is set by the deploy workflow; INTERNAL_API_KEY is mounted from Secret Manager (never set it as a plain env var).
# - SNAPSHOT_BUCKET/SNAPSHOT_PREFIX are optional and set by the deploy workflow from the SNAPSHOT_BUCKET repository variable.
# - OWID_* variables have safe defaults; override them only if you need a different upstream host, timeout, or cache TTL.
# See docs/deploy/cloud-run.md for the full runbook.
