# Application
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of exact allowed origins for cross-origin requests from the web frontend.
# A single origin is valid (e.g. https://your-app.vercel.app). Wildcards are not allowed here;
# use CORS_ORIGIN_PATTERN below for pattern-based origins such as Vercel preview deployments.
# Default when unset: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# CORS — optional anchored regex (^...$) for origin families that cannot be enumerated exactly,
# for example Vercel preview URLs. Leave empty or unset to allow only the exact origins above.
# Example:
# CORS_ORIGIN_PATTERN=^https://eco-metrics-earth-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_PATTERN=

# Swagger/OpenAPI — enable or disable the interactive API documentation UI.
# Set to "true" in development, "false" in production by default.
SWAGGER_ENABLED=false

# Production notes (Cloud Run):
# - PORT is injected by Cloud Run at runtime — never set it manually in the service env vars.
# - CORS_ORIGIN may contain multiple origins separated by commas.
# - CORS_ORIGIN_PATTERN is optional; set it to an anchored regex to allow Vercel preview origins.
# - SWAGGER_ENABLED should be "false" in production.
# See docs/deploy/cloud-run.md for the full runbook.
