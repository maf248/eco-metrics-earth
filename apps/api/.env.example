# Application
PORT=3001
NODE_ENV=development

# CORS — allowed origin for cross-origin requests from the web frontend.
# In production, set this to the deployed frontend URL (e.g. https://your-app.vercel.app).
# Default when unset: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Swagger/OpenAPI — enable or disable the interactive API documentation UI.
# Set to "true" in development, "false" in production by default.
SWAGGER_ENABLED=false

# Production notes (Cloud Run):
# - PORT is injected by Cloud Run at runtime — never set it manually in the service env vars.
# - CORS_ORIGIN should be the Vercel production URL.
# - SWAGGER_ENABLED should be "false" in production.
# See docs/deploy/cloud-run.md for the full runbook.
