{
  "name": "eco-metrics-earth",
  "version": "2.21.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --targets=dev,serve --all --parallel",
    "dev:local": "concurrently --names \"apps,proxy\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"caddy run --config dev/Caddyfile\"",
    "build": "nx run-many --target=build --all",
    "analyze": "nx run web:analyze",
    "test": "NX_NATIVE_COMMAND_RUNNER=false nx run-many --target=test --all --output-style=stream --parallel=1",
    "lint": "nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "prepare": "husky",
    "reset": "rm -rf node_modules .nx apps/web/.next packages/shared/dist && npm install",
    "typecheck": "nx run-many --target=typecheck --all",
    "clean:reports": "rm -rf coverage apps/api/test-output packages/shared/test-output",
    "update-snapshots": "NX_NATIVE_COMMAND_RUNNER=false nx run-many --target=test --all -- --updateSnapshot",
    "e2e": "nx e2e web",
    "geo:world": "node scripts/generate-world-geometry.mjs"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.16.1",
    "@next/bundle-analyzer": "16.4.5",
    "@nx/devkit": "23.3.1",
    "@nx/jest": "23.3.1",
    "@nx/js": "23.3.1",
    "@nx/nest": "23.3.1",
    "@nx/next": "23.3.1",
    "@nx/node": "23.3.1",
    "@nx/playwright": "23.3.1",
    "@nx/react": "23.3.1",
    "@nx/webpack": "23.3.1",
    "@playwright/test": "1.65.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "babel-jest": "30.5.2",
    "concurrently": "10.0.7",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "d3-geo": "3.1.2",
    "d3-geo-projection": "4.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "i18n-iso-countries": "7.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-environment-node": "30.5.2",
    "jest-util": "30.5.1",
    "lint-staged": "17.6.0",
    "nx": "23.3.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "sharp": "0.35.5",
    "topojson-client": "3.1.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "world-atlas": "2.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "axios": "1.21.0",
    "brace-expansion@^5": "5.0.12",
    "chokidar": "5.0.0",
    "follow-redirects": "1.16.2",
    "readdirp": "5.0.0",
    "rxjs": "7.8.2",
    "undici@^7": "7.30.1"
  }
}
