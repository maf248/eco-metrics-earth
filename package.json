{
  "name": "eco-metrics-earth",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --targets=dev,serve --all --parallel",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all --output-style=stream",
    "lint": "nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@nx/jest": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/nest": "22.6.5",
    "@nx/next": "22.6.5",
    "@nx/node": "22.6.5",
    "@nx/react": "22.6.5",
    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.24",
    "@swc/helpers": "0.5.21",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "autoprefixer": "10.4.27",
    "babel-jest": "30.3.0",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-environment-node": "30.3.0",
    "jest-util": "30.3.0",
    "lint-staged": "16.4.0",
    "nx": "22.6.5",
    "postcss": "8.5.9",
    "prettier": "3.8.2",
    "tailwindcss": "3.4.19",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "webpack-cli": "5.1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.18",
    "next": "16.1.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.json": [
      "prettier --write"
    ]
  }
}
