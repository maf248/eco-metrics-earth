{
  "name": "eco-metrics-earth",
  "version": "1.6.1",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --targets=dev,serve --all --parallel",
    "dev:local": "concurrently --names \"apps,proxy\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"caddy run --config dev/Caddyfile\"",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all --output-style=stream",
    "lint": "nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "prepare": "husky",
    "reset": "rm -rf node_modules .nx apps/web/.next packages/shared/dist && npm ci",
    "typecheck": "nx affected --target=typecheck --base=HEAD",
    "clean:reports": "rm -rf coverage apps/api/test-output packages/shared/test-output",
    "update-snapshots": "nx run-many --target=test --all -- --updateSnapshot"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.21",
    "@nx/jest": "22.7.2",
    "@nx/js": "22.7.2",
    "@nx/nest": "22.7.2",
    "@nx/next": "22.7.2",
    "@nx/node": "22.7.2",
    "@nx/react": "22.7.2",
    "@nx/webpack": "22.7.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.33",
    "@swc/helpers": "0.5.21",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "babel-jest": "30.4.1",
    "concurrently": "9.2.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-environment-node": "30.4.1",
    "jest-util": "30.4.1",
    "lint-staged": "16.4.0",
    "nx": "22.7.2",
    "postcss": "8.5.14",
    "prettier": "3.8.3",
    "semantic-release": "24.2.9",
    "semantic-release-monorepo": "8.0.2",
    "sharp": "0.34.5",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "webpack-cli": "7.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/platform-express": "11.1.21",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.json": [
      "prettier --write"
    ]
  },
  "overrides": {
    "chokidar": "5.0.0",
    "readdirp": "5.0.0"
  }
}
